{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/query-catalog.schema.json",
  "title": "Query Catalog Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "owner", "purpose", "source", "contract", "data_objects", "lifecycle"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable Query ID. Example: User.GetById",
      "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*){1,5}$"
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "description": "Owning team/module. Example: team-identity"
    },
    "purpose": {
      "type": "string",
      "minLength": 10,
      "description": "1-3 sentence purpose (semantic intent), not an SQL paraphrase."
    },
    "source": {
      "type": "string",
      "minLength": 2,
      "description": "Data source identifier. Example: postgres.main"
    },

    "status": {
      "type": "string",
      "description": "DEPRECATED ALIAS. Prefer lifecycle.status",
      "enum": ["draft", "active", "deprecated", "removed"]
    },

    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["params", "returns"],
      "properties": {
        "params": {
          "type": "array",
          "description": "Query parameters.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "required"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "type": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "description": { "type": "string" }
            }
          }
        },
        "returns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cardinality", "shape"],
          "properties": {
            "cardinality": {
              "type": "string",
              "enum": ["0..1", "1", "0..N", "1..N"]
            },
            "shape": {
              "type": "string",
              "minLength": 1,
              "description": "Result shape identifier (DTO/type) or short description."
            }
          }
        },
        "ordering": {
          "description": "Ordering rules for list results. Null when not applicable.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["by"],
              "properties": {
                "by": { "type": "string", "minLength": 1 },
                "direction": { "type": "string", "enum": ["asc", "desc"] }
              }
            }
          ]
        },
        "pagination": {
          "description": "Pagination rules for list results. Null when not applicable.",
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["strategy", "default_limit", "max_limit"],
              "properties": {
                "strategy": { "type": "string", "enum": ["cursor", "offset", "keyset"] },
                "default_limit": { "type": "integer", "minimum": 1 },
                "max_limit": { "type": "integer", "minimum": 1 },
                "cursor_param": { "type": "string" },
                "limit_param": { "type": "string" }
              }
            }
          ]
        },
        "errors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Error categories: not_found, forbidden, conflict, validation_failed, etc."
        },
        "notes": { "type": "string" }
      }
    },

    "data_objects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string" } },
        "write": { "type": "array", "items": { "type": "string" } }
      }
    },

    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transaction": { "type": "string", "enum": ["required", "optional", "forbidden"] },
        "idempotent": { "type": "string", "enum": ["true", "false", "conditional"] },
        "idempotency_notes": { "type": "string" },
        "isolation": { "type": "string" },
        "locking": { "type": "string" }
      }
    },

    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pii": { "type": "boolean" },
        "tenant_boundary": { "type": "string", "enum": ["enforced", "not_applicable", "unknown"] },
        "access": { "type": "string" },
        "notes": { "type": "string" }
      }
    },

    "performance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hot_path": { "type": "boolean" },
        "expected_latency_ms_p95": { "type": "integer", "minimum": 1 },
        "allow_unbounded": { "type": "boolean" },
        "allow_unbounded_reason": { "type": "string" },
        "notes": { "type": "string" }
      }
    },

    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log_query_id": { "type": "boolean" },
        "trace": { "type": "string", "enum": ["required", "recommended", "disabled"] },
        "sql_comment": { "type": "string", "enum": ["required", "recommended", "disabled"] },
        "metrics": { "type": "array", "items": { "type": "string" } }
      }
    },

    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use_cases": { "type": "array", "items": { "type": "string" } },
        "call_sites": { "type": "array", "items": { "type": "string" } },
        "docs": { "type": "array", "items": { "type": "string" } }
      }
    },

    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["draft", "active", "deprecated", "removed"] },
        "since": { "type": "string", "format": "date" },
        "deprecated_since": { "type": "string", "format": "date" },
        "replaced_by": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*){1,5}$" },
        "removal_by": { "type": "string", "format": "date" },
        "removed_at": { "type": "string", "format": "date" },
        "reason": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "deprecated" } } },
          "then": { "required": ["replaced_by", "removal_by", "reason"] }
        },
        {
          "if": { "properties": { "status": { "const": "removed" } } },
          "then": { "required": ["removed_at", "reason"] }
        }
      ]
    },

    "extensions": {
      "type": "object",
      "description": "Optional extension fields to avoid loosening the core schema.",
      "additionalProperties": true
    }
  }
}
